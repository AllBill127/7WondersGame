<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>7Wonders</AssemblyName>
    <RootNamespace>_7Wonders.Cli</RootNamespace>
    <!-- the search copies the game every iteration, so games run in parallel fight over the workstation GC
         (8 parallel MCTS games: 5.4 s per game with it, 3.2 s with the server GC; one at a time also ~8% faster) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\7Wonders.Engine\7Wonders.Engine.csproj" />
    <ProjectReference Include="..\7Wonders.Agents\7Wonders.Agents.csproj" />
  </ItemGroup>

  <!-- run.json records the commit (stamped into InformationalVersion by the SDK);
       mark builds with uncommitted source changes anywhere in the repository (bin/ and obj/ ignored) as "-dirty". -->
  <Target Name="MarkDirtySourceRevision" AfterTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' != ''">
    <Exec Command="git status --porcelain -- . &quot;:(exclude)**/bin/**&quot; &quot;:(exclude)**/obj/**&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)/.." ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatus" />
    </Exec>
    <PropertyGroup Condition="'$(_GitStatus)' != ''">
      <SourceRevisionId>$(SourceRevisionId)-dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="7Wonders.Tests" />
  </ItemGroup>

</Project>
